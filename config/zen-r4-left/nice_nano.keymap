#include <behaviors.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <behaviors/javelin_steno.dtsi>
#include <behaviors/plover_hid.dtsi>
#include <dt-bindings/zmk/hid-io/plover_hid.h>
#include <dt-bindings/zmk/javelin_steno.h>
#include "../../tools/zen-r4-qspi/qspi.overlay"

#define MAIN 0
#define SYM_NUM 1
#define JAVELIN 2
#define PLOVER_HID 3

/ {
    chosen {
        zmk,kscan = &left_kscan;
        zmk,matrix-transform = &left_transform;
    };

    left_kscan: left_kscan {
        compatible = "zmk,kscan-gpio-matrix";
#include "left-matrix.dtsi"
    };

    left_transform: left_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
                                    RC(3,3) RC(3,4) RC(3,5)
        >;
    };

    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            display-name = "MAIN";
            bindings = <
                &ht ESC TAB &ht LBKT Q  &ht RBKT W  &ht LBRC E  &ht RBRC R &ht SQT T
                &kp LCTRL   &ht LG(A) A &ht LG(S) S &ht LPAR D  &ht RPAR F &ht DQT G
                &kp LSHIFT  &ht LG(Z) Z &ht LG(X) X &ht LG(C) C &ht LG(V) V &ht GRAVE B
                                                    &to JAVELIN &to PLOVER_HID &lt SYM_NUM BSPC
            >;
        };

        sym_num_layer {
            display-name = "SYM+NUM";
            bindings = <
                &kp LG(LA(ESC)) &kp N1 &kp N2   &kp UP    &kp N3    &kp N4
                &none          &none  &kp LEFT &kp DOWN  &kp RIGHT &kp RET
                &kp LS(LEFT)   &none  &none    &kp SPACE &none     &none
                                               &trans    &trans    &trans
            >;
        };

        javelin_layer {
            display-name = "JAVELIN";
            // The first column's -T and E permit one-half Lapwing testing.
            bindings = <
                &javsteno STENO_NUM12 &javsteno STENO_NUM1 &javsteno STENO_NUM2 &javsteno STENO_NUM3 &javsteno STENO_NUM4 &javsteno STENO_NUM5
                &javsteno STENO_TR    &javsteno STENO_NUM1  &javsteno STENO_TL   &javsteno STENO_PL   &javsteno STENO_HL   &javsteno STENO_STAR1
                &javsteno STENO_E     &javsteno STENO_S2   &javsteno STENO_KL   &javsteno STENO_WL   &javsteno STENO_RL   &javsteno STENO_STAR2
                                                                               &to MAIN            &javsteno STENO_A    &javsteno STENO_O
            >;
        };

        plover_hid_layer {
            display-name = "PLOVER HID";
            bindings = <
                &plv PLV_NMC &plv PLV_NM  &plv PLV_NM2 &plv PLV_NM3 &plv PLV_NM4 &plv PLV_NM5
                &plv PLV_TR  &plv PLV_NM  &plv PLV_TL  &plv PLV_PL  &plv PLV_HL  &plv PLV_ST
                &plv PLV_E   &plv PLV_SL2 &plv PLV_KL  &plv PLV_WL  &plv PLV_RL  &plv PLV_ST2
                                                        &to MAIN     &plv PLV_A   &plv PLV_O
            >;
        };
    };
};

&uart0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&i2c0 { status = "disabled"; };
