menu "Javelin Steno Engine"

config ZMK_JAVELIN_STENO
    bool "Enable Javelin steno engine"
    default n
    select CPP
    select REQUIRES_FULL_LIBCPP

if ZMK_JAVELIN_STENO

config ZMK_JAVELIN_STENO_DICT_PLOVER
    bool "Include Plover dictionary (standard English)"
    default y

config ZMK_JAVELIN_STENO_DICT_LAPWING
    bool "Include Lapwing dictionary (modern, recommended for new learners)"
    default n

config ZMK_JAVELIN_STENO_EXTERNAL_LAPWING
    bool "Use the Zen R4's external QSPI Lapwing dictionary"
    depends on SOC_NRF52840 && ZMK_USB_LOGGING
    select NRFX_QSPI
    select CRC

config ZMK_JAVELIN_STENO_BROWSER_DICTIONARY
    bool "Edit the personal dictionary over Javelin WebHID"
    depends on ZMK_JAVELIN_STENO_EXTERNAL_LAPWING

config ZMK_JAVELIN_STENO_MACOS_US_LAYOUT
    bool "Use macOS U.S./ABC accent and symbol keys in onboard Javelin"
    help
      Enable when the host uses the macOS U.S. or ABC input source.
      ASCII keys continue to use Javelin's US layout.

endif # ZMK_JAVELIN_STENO

endmenu
